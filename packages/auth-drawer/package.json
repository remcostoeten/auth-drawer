{
  "name": "@remcostoeten/auth-drawer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./styles.css": "./dist/styles.css",
    "./styles/tailwind.css": "./styles/tailwind.css"
  },
  "files": [
    "dist",
    "styles"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "NODE_ENV=production tailwindcss -i ./styles/build.css -o ./styles/bundle.css --minify && NODE_ENV=production vite build && node ./scripts/stamp-css-import.mjs",
    "dev": "vite build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "framer-motion": "^12.0.0",
    "lucide-react": "^0.400.0"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react-swc": "^3.11.0",
    "framer-motion": "^12.38.0",
    "jsdom": "^29.1.1",
    "lucide-react": "^0.462.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "rolldown-vite": "^7.3.1",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.8.3",
    "vitest": "^4.1.6"
  }
}
