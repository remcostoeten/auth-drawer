  "scripts": {
    "build": "rm -rf dist && bun run build:core && bun run build:react && bun run build:solid",
    "build:core": "NODE_ENV=production node ./node_modules/rolldown-vite/bin/vite.js build -c vite.core.config.ts && tsc -p src/core/tsconfig.build.json",
    "build:react": "NODE_ENV=production tailwindcss -i ./styles/react/build.css -o ./styles/react/bundle.css --minify && NODE_ENV=production node ./node_modules/rolldown-vite/bin/vite.js build -c vite.react.config.ts && tsc -p src/react/tsconfig.build.json && node ./scripts/stamp-react-css-import.mjs",
    "build:solid": "NODE_ENV=production tsup --config tsup.solid.config.ts && NODE_ENV=production tailwindcss -i ./styles/solid/build.css -o ./dist/solid/styles.css --minify && node ./scripts/stamp-solid-css-import.mjs",
    "dev": "node ./node_modules/rolldown-vite/bin/vite.js build -c vite.react.config.ts --watch",
    "prepublishOnly": "bun run build && bun run test",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p src/core/tsconfig.json && tsc -p src/react/tsconfig.json && tsc -p src/solid/tsconfig.json"
  },
