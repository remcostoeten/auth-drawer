{
    "name": "auth-drawer-monorepo",
    "private": true,
    "type": "module",
    "workspaces": [
        "packages/*",
        "showcase"
    ],
    "scripts": {
        "build": "turbo run build",
        "dev": "turbo run dev",
        "start": "turbo run preview",
        "lint": "turbo run lint",
        "format": "turbo run format",
        "test": "turbo run test",
        "typecheck": "turbo run typecheck",
        "publish:auth-drawer": "npm publish -w @remcostoeten/auth-drawer --access public",
        "example:better-auth": "cd examples/better-auth-nextjs && bun install && bun run dev:all",
        "example:custom-jwt": "cd examples/custom-jwt-nextjs && bun install && bun run dev:all",
        "example:passport": "cd examples/passport-express && bun run dev:all"
    },
    "devDependencies": {
        "turbo": "^2.5.4"
    },
    "packageManager": "bun@1.3.13"
}
