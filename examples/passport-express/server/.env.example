# PostgreSQL (matches docker-compose.yml)
DATABASE_URL=postgresql://passport_demo:passport_demo@localhost:5435/passport_demo

# express-session signing secret — use a long random string (openssl rand -base64 32)
SESSION_SECRET=replace-with-a-long-random-string

# Origin of the Next.js frontend, allowed through CORS with credentials
WEB_URL=http://localhost:3006

# API port
PORT=4000
