{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "vitest", "unicorn", "oxc"],
  "categories": {
    "correctness": "error"
  },
  "ignorePatterns": ["dist", "node_modules"],
  "rules": {
    "react/only-export-components": "warn"
  },
  "env": {
    "browser": true,
    "builtin": true,
    "node": true,
    "vitest": true
  },
  "settings": {
    "react": {
      "version": "18.3.1"
    }
  }
}
